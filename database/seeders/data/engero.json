 },
 {
  "n": 58,
  "luganda": "Bbugubbugu si muliro, essanja teriyiisa mmere",
  "note": null
 },
 {
  "n": 59,
  "luganda": "Bukaajumbe, anaabusereka akeera",
  "note": null
 },
 {
  "n": 60,
  "luganda": "Buyisi bwomu, nsega y'ebika",
  "note": null
 },
 {
  "n": 61,
