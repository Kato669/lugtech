 },
 {
  "n": 55,
  "luganda": "Basajja mivule, giwaatula ne giggumiza",
  "note": "Very like #23 \"Abasajja mivule, giwaatula ne giggumiza\". Keep both, correct one, or delete this one."
 },
 {
  "n": 56,
  "luganda": "Batta migya, beerabira emikadde (emikwano)",
  "note": null
 },
 {
  "n": 57,
