  "note": null
 },
 {
  "n": 12,
  "luganda": "Gwolya naye enkejje enjokerere, y'akuyita ddumabikalu",
  "note": null
 },
 {
  "n": 13,
  "luganda": "Obwato bufa magoba",
  "note": null
 },
 {
  "n": 14,
  "luganda": "Oguweddeko entonto, ennyonyi ziguyita ttale / bbali (omutuba)",
  "note": null
 },
 {
  "n": 15,
