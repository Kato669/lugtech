  "note": null
 },
 {
  "n": 16,
  "luganda": "Omunaku eyeegulira, y'alya akawera",
  "note": null
 },
 {
  "n": 17,
  "luganda": "Omuyomjo omutono, gukyamya enkoko ekyensuti",
  "note": null
 },
 {
  "n": 18,
  "luganda": "Ssebageya nnyonyi, nga namunye ali kunju",
  "note": null
 },
 {
  "n": 19,
  "luganda": "Tunaagabanira mitala, yakuseera",
  "note": null
 },
 {
  "n": 20,
  "luganda": "Zimba nnene, tagikubeera",
  "note": null
 },
 {
  "n": 21,
  "luganda": "Abalungi mbwa yanamaaso, bwetebba n'eyigga",
  "note": null
 },
 {
  "n": 22,
  "luganda": "Abantu balamu bitooke bisalire, tebyekwekwamu",
  "note": null
 },
 {
  "n": 23,
  "luganda": "Abasajja mivule, giwaatula ne giggumiza",
  "note": null
 },
 {
  "n": 24,
  "luganda": "Abikka ebibiri, tabojjerera",
  "note": null
 },
 {
  "n": 25,
  "luganda": "Akakuli mu linnyo, tekaganya lulimi kutereera",
  "note": null
 },
 {
  "n": 26,
  "luganda": "Akakyama amamera, bwokagolola kamenyeka bumenyesi",
  "note": null
 },
 {
  "n": 27,
  "luganda": "Akalya amaggwa, keekamanya bwekagakyusa",
  "note": null
 },
 {
  "n": 28,
  "luganda": "Akola bikolemu, ng'atikkula ava emugga",
  "note": null
 },
 {
  "n": 29,
  "luganda": "Akusuubiza, akira akuma",
  "note": null
 },
 {
  "n": 30,
  "luganda": "Alima ne bba, taba munafu",
  "note": null
 },
 {
  "n": 31,
  "luganda": "Amasaawa, si malima",
  "note": null
 },
 {
  "n": 32,
  "luganda": "Anaalemwa ebbuzi okutuga, nti lintuunuulidde!",
  "note": null
 },
 {
  "n": 33,
  "luganda": "Anaatuubya engo, embuzi agisiba ku luzibaziba",
  "note": null
 },
 {
  "n": 34,
  "luganda": "Anakuggya ennimi, ageya nnyoko ngowulira",
  "note": null
 },
 {
  "n": 35,
  "luganda": "Asimba ensogasoga, teyeeganya mayuba",
  "note": null
 },
 {
  "n": 36,
  "luganda": "Asimba kasooli tamulya makoola, amulinda kwengera",
  "note": null
 },
 {
  "n": 37,
