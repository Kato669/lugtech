[
 {
  "n": 1,
  "luganda": "Akugoba, yakuwa amagezi",
  "note": null
 },
 {
  "n": 2,
  "luganda": "Bulikuggwa, obugole ssi bumbejja",
  "note": null
 },
 {
  "n": 3,
  "luganda": "Ebibuuka bitalaganye, bikubagana empawa",
  "note": null
 },
 {
  "n": 4,
  "luganda": "Ekibaawo kimala, ennyindo y'enkoko kye kyenyi",
  "note": null
 },
 {
  "n": 5,
  "luganda": "Ekimala empaka, kusirika",
  "note": null
 },
 {
  "n": 6,
  "luganda": "Engabi eyeewala, yekaluba ennyama",
  "note": null
 },
 {
  "n": 7,
  "luganda": "Ensiba mbi. Eddibya mutere",
  "note": null
 },
 {
  "n": 8,
  "luganda": "Ensimbi kyeremwa, ow'enkata tazinga",
  "note": null
 },
 {
  "n": 9,
  "luganda": "Enswa emu, ekira eddembwe",
  "note": null
 },
 {
  "n": 10,
  "luganda": "Entubire eteekumire tekukwasa ku nkanaga",
  "note": null
 },
 {
  "n": 11,
