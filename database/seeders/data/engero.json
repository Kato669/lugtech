  "note": null
 },
 {
  "n": 38,
  "luganda": "Ataalukutambulire, entanda akusibira yameenvu",
  "note": null
 },
 {
  "n": 39,
  "luganda": "Atali nannyini mbooli, asima aligguula",
  "note": null
 },
 {
  "n": 40,
  "luganda": "Atannasesema, ye yeetenda okugonza",
  "note": null
 },
 {
  "n": 41,
  "luganda": "Ataawone bwavu, asuubula magi nansuwa",
  "note": null
 },
 {
  "n": 42,
  "luganda": "Atega ogumu, taliira",
  "note": null
 },
 {
  "n": 43,
